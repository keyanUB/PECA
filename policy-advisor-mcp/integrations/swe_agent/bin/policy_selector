#!/usr/bin/env python3
"""Thin SWE-agent command adapter; all policy logic remains in the MCP service."""
import os
import sys

from policy_selector.client import main

if len(sys.argv) != 3:
    raise SystemExit("Usage: policy_selector <tool> <request_file>")
args = ["call", sys.argv[1], "--input", sys.argv[2]]
if os.getenv("POLICY_SELECTOR_MCP_URL"):
    args = ["--url", os.environ["POLICY_SELECTOR_MCP_URL"], *args]
raise SystemExit(main(args))
